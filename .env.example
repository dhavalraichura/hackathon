# ─────────────────────────────────────────────
# .env.example — Copy this to .env and fill in
# cp .env.example .env
# ─────────────────────────────────────────────

# LLM Provider: ollama (free local) | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Ollama server (default, no change needed if running locally)
OLLAMA_URL=http://localhost:11434

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic Claude (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
